[Unit]
Description=Zellij Web Client Server (Omarchy Online)
Documentation=https://github.com/zellij-org/zellij
After=network.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/zellij web --ip 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=3
KillMode=mixed

[Install]
WantedBy=default.target
