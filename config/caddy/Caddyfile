# Omarchy Online - Caddy Gateway Configuration
# Reverse Proxy to Zellij Web Client with TLS Termination & Web Shell

{
	admin 127.0.0.1:2020
	auto_https disable_redirects
}

:8443 {
	tls /home/ubuntu/Projects/omarchy-online/config/caddy/cert.pem /home/ubuntu/Projects/omarchy-online/config/caddy/key.pem

	# Security Headers
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 1. Reverse proxy to Zellij Web server under /zellij/
	handle_path /zellij* {
		reverse_proxy 127.0.0.1:8082 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_down -X-Frame-Options
			header_down X-Frame-Options "SAMEORIGIN"
		}
	}

	# 2. Serve Omarchy Web Shell Frontend
	handle {
		root * /home/ubuntu/Projects/omarchy-online/web
		file_server
		try_files {path} /index.html
	}
}
